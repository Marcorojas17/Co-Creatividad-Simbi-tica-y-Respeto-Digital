{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [".env.example", "tsconfig.json"],
  "globalEnv": ["NODE_ENV"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "build/**", "!.next/cache/**"],
      "inputs": ["$TURBO_DEFAULT$", "!**/*.test.ts", "!**/*.spec.ts"],
      "env": ["NEXT_PUBLIC_*"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "outputs": ["coverage/**"],
      "inputs": ["src/**", "tests/**", "$TURBO_DEFAULT$"]
    },
    "test:coverage": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "outputs": [],
      "inputs": ["$TURBO_DEFAULT$", ".eslintrc*"]
    },
    "type-check": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    },
    "compliance:sec": {
      "outputs": ["compliance/reports/**"],
      "cache": false
    },
    "compliance:licenses": {
      "outputs": ["compliance/licenses/**"],
      "cache": false
    },
    "compliance:seal": {
      "dependsOn": ["compliance:sec", "compliance:licenses", "test"],
      "outputs": ["compliance/seal/**"],
      "cache": false
    },
    "frequency": {
      "outputs": ["core-dsp/reports/**"],
      "cache": false
    }
  }
}
