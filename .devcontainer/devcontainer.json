{
  "name": "KRONOS CYMATIC GOLD",
  "image": "mcr.microsoft.com/devcontainers/universal:2-linux",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20", "installYarnUsingApt": true },
    "ghcr.io/devcontainers/features/python:1": { "version": "3.11" },
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "version": "latest", "dockerDashComposeVersion": "v2" },
    "ghcr.io/devcontainers/features/github-cli:1": { "version": "latest" }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint", "esbenp.prettier-vscode", "ms-vscode.vscode-typescript-next",
        "ms-python.python", "ms-python.vscode-pylance", "ms-vscode.live-server",
        "raczzalan.webgl-glsl-editor", "slevesque.shader", "ms-azuretools.vscode-docker",
        "redhat.vscode-yaml", "tamasfe.even-better-toml", "GitHub.vscode-github-actions"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "files.eol": "\n"
      }
    }
  },
  "forwardPorts": [3000, 4000, 5173, 8000, 5432],
  "postCreateCommand": "npm install --no-audit --no-fund && pip install -r requirements.txt && git config --global --add safe.directory /workspaces/*",
  "postStartCommand": "sudo chown -R node:node /workspaces",
  "remoteUser": "node",
  "mounts": [
    "source=kronos-gpg-cache,target=/home/node/.gnupg,type=volume",
    "source=kronos-node-modules,target=/workspaces/node_modules,type=volume"
  ],
  "runArgs": ["--init"]
}
