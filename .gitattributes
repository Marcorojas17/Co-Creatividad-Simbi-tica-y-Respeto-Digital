# =============================================
# KRONOS-28-ITZA 289 PLATINUM - GIT ATTRIBUTES
# 003 de 150 - Control total de Git + Linguist
# =============================================

# 1. DEFAULT - Todo texto a LF, normaliza Windows CRLF -> LF
* text=auto eol=lf
*.* text=auto

# 2. TEXT FILES - Forzado LF explicito
*.js text eol=lf diff=javascript
*.ts text eol=lf diff=typescript
*.jsx text eol=lf diff=javascript
*.tsx text eol=lf diff=typescript
*.json text eol=lf
*.jsonc text eol=lf
*.md text eol=lf diff=markdown
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.html text eol=lf diff=html
*.css text eol=lf diff=css
*.scss text eol=lf
*.sh text eol=lf diff=bash
*.bash text eol=lf
*.py text eol=lf diff=python

# 3. GLSL / SHADERS - KRONOS Gold Shaders - Linguist detecta como GLSL
*.vert text eol=lf linguist-language=GLSL
*.frag text eol=lf linguist-language=GLSL
*.glsl text eol=lf linguist-language=GLSL
*.wgsl text eol=lf linguist-language=wgsl
*.hlsl text eol=lf linguist-language=HLSL

# 4. DOCKER / CONFIG
Dockerfile text eol=lf
*.dockerfile text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
*.env.example text eol=lf

# 5. BINARY FILES - Protegidos, sin diff ni merge
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.avif binary
*.mp4 binary
*.mp3 binary
*.wav binary
*.pdf binary
*.zip binary
*.gz binary
*.tar binary
*.woff binary
*.woff2 binary
*.eot binary
*.ttf binary
*.otf binary
*.wasm binary
*.pyc binary
*.pyo binary
*.bin binary

# 6. LOCK FILES - Marcados como generados, no cuentan en Linguist
package-lock.json linguist-generated=true
yarn.lock linguist-generated=true
pnpm-lock.yaml linguist-generated=true
poetry.lock linguist-generated=true
Pipfile.lock linguist-generated=true
*.lock linguist-generated=true

# 7. VENDORS & BUILD - Excluir de stats de lenguaje
node_modules/** linguist-vendored=true
dist/** linguist-generated=true
build/** linguist-generated=true
.parcel-cache/** linguist-vendored=true
coverage/** linguist-generated=true

# 8. COMPLIANCE & DOCS - Detectados como Markdown para stats
compliance/** linguist-documentation=true
*.md linguist-documentation=false
PRICING.md linguist-documentation=false
SECURITY.md linguist-documentation=false

# 9. LFS - Si usas archivos grandes (opcional, listo para futuro)
# *.psd filter=lfs diff=lfs merge=lfs -text
# *.ai filter=lfs diff=lfs merge=lfs -text
# *.blend filter=lfs diff=lfs merge=lfs -text

# 10. EXPORT-IGNORE - No incluir en git archive / zip de GitHub
.git/** export-ignore
.github/** export-ignore
.devcontainer/** export-ignore
node_modules/** export-ignore
*.log export-ignore
.env export-ignore
.env.local export-ignore
