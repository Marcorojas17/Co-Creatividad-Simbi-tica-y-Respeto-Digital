{
  "buildCommand": "pnpm --filter web build",
  "outputDirectory": "apps/web/dist",
  "framework": "vite",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/docs", "destination": "/api" },
    { "source": "/openapi.yaml", "destination": "/api" },
    { "source": "/openapi.json", "destination": "/api" }
  ]
}
