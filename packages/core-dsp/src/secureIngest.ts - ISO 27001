export class SecureAudioIngest {
  static MAX_SIZE = 20 * 1024 * 1024 // 20 MB NOM-151
  static ALLOWED = ['audio/mpeg', 'audio/mp3', 'audio/wav', 'audio/x-m4a']

  static validate(file: File) {
    if (file.size > this.MAX_SIZE) throw new Error(`ISO 27001: Archivo ${ (file.size/1024/1024).toFixed(1)} MB excede 20 MB`)
    if (!this.ALLOWED.includes(file.type)) throw new Error(`ISO 27001: Tipo ${file.type} no permitido`)
    if (file.name.includes('..') || file.name.includes('/')) throw new Error('ISO 27001: Nombre inválido')
    return true
  }

  static async toFFT(file: File) {
    this.validate(file)
    const ctx = new AudioContext()
    const buf = await file.arrayBuffer()
    const audio = await ctx.decodeAudioData(buf)
    const analyser = ctx.createAnalyser()
    analyser.fftSize = 2048
    return { audio, analyser, duration: audio.duration, sampleRate: audio.sampleRate }
  }
}
